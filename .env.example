# Copy to .env for local overrides. Never put real API keys in this file.

# Bind address. Default is localhost only.
GEOSCOUT_HOST=127.0.0.1
GEOSCOUT_PORT=8000

# SQLite path (WAL is enabled in code)
GEOSCOUT_DATA_DIR=./data

# NCBI E-utilities identity. Email must be YOUR contact address, not a third-party user.
# NCBI docs: include tool + email on every request. Do not hardcode a maintainer address in code.
GEOSCOUT_NCBI_TOOL=GEOScout
GEOSCOUT_NCBI_EMAIL=

# Optional NCBI API key (raises E-utilities limit from 3 to 10 r/s). Separate from model keys.
GEOSCOUT_NCBI_API_KEY=

# live = real NCBI requests. mock = fixture-only (tests). Never falls back automatically.
GEOSCOUT_NCBI_MODE=live

# live = real OpenAI-compatible API. mock = deterministic local fake (tests / no key).
GEOSCOUT_LLM_MODE=live

# Demo mode is opt-in and must never be used as a silent fallback for failed live searches.
GEOSCOUT_ALLOW_DEMO=false
GEOSCOUT_DEMO_MODE=false

# Internal token for worker-to-API credential fetch. Generated on first start if empty.
GEOSCOUT_INTERNAL_TOKEN=

# CORS: comma-separated origins allowed to call the local API.
GEOSCOUT_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000
